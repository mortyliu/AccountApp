QMainWindow {
    background-color: #f5f5f5;
}

QWidget {
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 14px;
}

QTabWidget::pane {
    border: 1px solid #e0e0e0;
    background-color: #ffffff;
}

QTabWidget::tab-bar {
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #f0f0f0;
    color: #666666;
    padding: 8px 16px;
    margin-right: 4px;
    border-radius: 4px 4px 0 0;
    border: 1px solid #e0e0e0;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #333333;
    border-color: #e0e0e0;
}

QTabBar::tab:hover {
    background-color: #f8f8f8;
}

QTableView {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    background-color: #ffffff;
}

QTableView::header {
    background-color: #f5f5f5;
}

QTableView::header::section {
    background-color: #f5f5f5;
    color: #666666;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #e0e0e0;
}

QTableView::item {
    padding: 6px;
    border-bottom: 1px solid #f0f0f0;
}

QTableView::item:hover {
    background-color: #f8f8f8;
}

QTableView::item:selected {
    background-color: #e3f2fd;
    color: #1976d2;
}

QLineEdit {
    padding: 6px 10px;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #ffffff;
}

QLineEdit:focus {
    border-color: #1976d2;
    outline: none;
}

QLineEdit::placeholder {
    color: #999999;
}

QComboBox {
    padding: 6px 10px;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #ffffff;
}

QComboBox:focus {
    border-color: #1976d2;
    outline: none;
}

QDateEdit {
    padding: 6px 10px;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    background-color: #ffffff;
}

QDateEdit:focus {
    border-color: #1976d2;
    outline: none;
}

QPushButton {
    padding: 6px 16px;
    border: none;
    border-radius: 4px;
    color: #ffffff;
    background-color: #1976d2;
}

QPushButton:hover {
    background-color: #1565c0;
}

QPushButton:pressed {
    background-color: #0d47a1;
}

QPushButton:disabled {
    background-color: #bdbdbd;
    color: #9e9e9e;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
}

QMenuBar::item {
    padding: 8px 16px;
    color: #333333;
}

QMenuBar::item:hover {
    background-color: #f5f5f5;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 20px;
    color: #333333;
}

QMenu::item:hover {
    background-color: #e3f2fd;
    color: #1976d2;
}

QLabel {
    color: #666666;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #333333;
}

QChartView {
    background-color: #ffffff;
}

QChart {
    background-color: #ffffff;
}
