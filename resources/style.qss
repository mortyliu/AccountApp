* {
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #F5F5F5;
}

QWidget#centralWidget {
    background-color: #F5F5F5;
}

QWidget#sidebar {
    background-color: #1a1a2e;
    border: none;
    border-right: 1px solid #16213e;
}

QPushButton#navBtn {
    background-color: transparent;
    color: #a0a0b8;
    border: none;
    border-radius: 4px;
    padding: 10px 16px;
    text-align: left;
    font-size: 14px;
    min-height: 20px;
}

QPushButton#navBtn:hover {
    background-color: #16213e;
    color: #e0e0f0;
}

QPushButton#navBtn:checked {
    background-color: #1890FF;
    color: #ffffff;
    font-weight: bold;
}

QLabel#sidebarTitle {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
    padding: 20px 20px 10px 20px;
}

QLabel#sidebarSubtitle {
    color: #533483;
    font-size: 12px;
    color: #666666;
    padding: 0px 20px 20px 20px;
}

QLabel#pageTitle {
    color: #1a1a2e;
    font-size: 16px;
    font-weight: bold;
    padding: 0px;
    background-color: transparent;
}

QFrame#cardFrame {
    background-color: #ffffff;
    border-radius: 4px;
    border: none;
    padding: 0px;
}

QFrame#cardFrame QLabel {
    color: #333333;
    background-color: transparent;
}

QLabel#cardTitle {
    color: #666666;
    font-size: 12px;
    background-color: transparent;
}

QLabel#cardValue {
    color: #1a1a2e;
    font-size: 24px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#incomeValue {
    color: #00b894;
    font-size: 24px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#expenseValue {
    color: #e17055;
    font-size: 24px;
    font-weight: bold;
    background-color: transparent;
}

QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabWidget::tab-bar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #888888;
    padding: 8px 20px;
    margin-right: 2px;
    border: none;
    border-bottom: 3px solid transparent;
    font-size: 14px;
}

QTabBar::tab:selected {
    color: #1890FF;
    border-bottom: 3px solid #1890FF;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    color: #333333;
    border-bottom: 3px solid #d0d0d0;
}

QTableView {
    border: none;
    border-radius: 4px;
    background-color: #ffffff;
    gridline-color: #F5F5F5;
    selection-background-color: #e6f7ff;
    selection-color: #1890FF;
    alternate-background-color: #fafbfc;
}

QTableView::header {
    background-color: #fafbfc;
}

QTableView::header::section {
    background-color: #fafbfc;
    color: #666666;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #E8E8E8;
    font-weight: bold;
    font-size: 12px;
}

QTableView::item {
    padding: 4px 8px;
    border-bottom: 1px solid #F5F5F5;
    height: 24px;
}

QTableView::item:hover {
    background-color: #f0f4ff;
}

QTableView::item:selected {
    background-color: #e6f7ff;
    color: #1890FF;
}

QLineEdit {
    height: 28px;
    padding: 2px 6px;
    border: 1px solid #E8E8E8;
    border-radius: 4px;
    background-color: #ffffff;
    color: #333333;
    selection-background-color: #1890FF;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #1890FF;
}

QLineEdit::placeholder {
    color: #bbbbbb;
}

QComboBox {
    height: 28px;
    padding: 2px 6px;
    border: 1px solid #E8E8E8;
    border-radius: 4px;
    background-color: #ffffff;
    color: #333333;
    min-width: 80px;
}

QComboBox:focus {
    border-color: #1890FF;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    border: 1px solid #E8E8E8;
    border-radius: 4px;
    background-color: #ffffff;
    selection-background-color: #e6f7ff;
    selection-color: #1890FF;
    padding: 4px;
    outline: none;
}

QDateEdit {
    height: 28px;
    padding: 2px 6px;
    border: 1px solid #E8E8E8;
    border-radius: 4px;
    background-color: #ffffff;
    color: #333333;
}

QDateEdit:focus {
    border-color: #1890FF;
}

QDateEdit::drop-down {
    border: none;
    width: 24px;
}

QPushButton {
    min-width: 80px;
    height: 30px;
    padding: 2px 16px;
    border: none;
    border-radius: 4px;
    color: #ffffff;
    background-color: #1890FF;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #40a9ff;
}

QPushButton:pressed {
    background-color: #096dd9;
}

QPushButton:disabled {
    background-color: #d0d0d0;
    color: #999999;
}

QPushButton#dangerBtn {
    background-color: #e17055;
}

QPushButton#dangerBtn:hover {
    background-color: #d35400;
}

QPushButton#dangerBtn:pressed {
    background-color: #c0392b;
}

QPushButton#secondaryBtn {
    background-color: #F5F5F5;
    color: #555555;
    border: 1px solid #E8E8E8;
}

QPushButton#secondaryBtn:hover {
    background-color: #E8E8E8;
    color: #333333;
}

QPushButton#secondaryBtn:pressed {
    background-color: #d0d0d0;
}

QPushButton#importBtn {
    background-color: #00b894;
}

QPushButton#importBtn:hover {
    background-color: #00a381;
}

QPushButton#importBtn:pressed {
    background-color: #008c6e;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #E8E8E8;
    padding: 2px;
}

QMenuBar::item {
    padding: 6px 14px;
    color: #555555;
    border-radius: 4px;
}

QMenuBar::item:hover {
    background-color: #F5F5F5;
    color: #1890FF;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #E8E8E8;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 14px;
    color: #333333;
    border-radius: 4px;
}

QMenu::item:hover {
    background-color: #e6f7ff;
    color: #1890FF;
}

QMenu::separator {
    height: 1px;
    background-color: #F5F5F5;
    margin: 4px 8px;
}

QLabel {
    color: #555555;
}

QLabel#sectionLabel {
    color: #666666;
    font-size: 12px;
    font-weight: bold;
    padding: 0px 0px 4px 0px;
    background-color: transparent;
}

QLabel#hintLabel {
    font-size: 12px;
    color: #666666;
    background-color: transparent;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #d0d0d0;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #b0b0b0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #d0d0d0;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #b0b0b0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #333333;
}

QChartView {
    background-color: #ffffff;
    border-radius: 4px;
}

QChart {
    background-color: #ffffff;
}

QSpinBox {
    height: 28px;
    padding: 2px 6px;
    border: 1px solid #E8E8E8;
    border-radius: 4px;
    background-color: #ffffff;
    color: #333333;
}

QSpinBox:focus {
    border-color: #1890FF;
}

QGroupBox {
    border: 1px solid #E8E8E8;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
    color: #555555;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 8px;
    color: #1890FF;
}

QToolTip {
    background-color: #1a1a2e;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
}

QTreeWidget {
    border: none;
    border-radius: 4px;
    background-color: #ffffff;
    alternate-background-color: #fafbfc;
    outline: none;
    padding: 4px;
}

QTreeWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid #F5F5F5;
    border-radius: 4px;
}

QTreeWidget::item:hover {
    background-color: #f0f4ff;
}

QTreeWidget::item:selected {
    background-color: #e6f7ff;
    color: #1890FF;
}

QTreeWidget::branch {
    background-color: transparent;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/branch-closed.svg);
    width: 16px;
    height: 16px;
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/branch-open.svg);
    width: 16px;
    height: 16px;
}

#categoryHeader {
    background-color: #ffffff;
    border-bottom: 1px solid #F5F5F5;
}

#closeTabBtn {
    font-size: 20px;
    color: #999999;
    border: none;
    background: transparent;
    border-radius: 4px;
}

#closeTabBtn:hover {
    color: #333333;
    background-color: #F5F5F5;
}

#categoryTab {
    font-size: 14px;
    font-weight: 500;
    color: #888888;
    border: none;
    background: transparent;
    padding: 0 12px;
    margin: 0 4px;
    border-bottom: 2px solid transparent;
}

#categoryTab:hover {
    color: #555555;
}

#categoryTab:checked {
    color: #1890FF;
    font-weight: 600;
    border-bottom: 2px solid #1890FF;
}

#addCategoryBtn {
    font-size: 18px;
    font-weight: bold;
    color: #1890FF;
    border: 1px solid #1890FF;
    background: white;
    border-radius: 4px;
}

#addCategoryBtn:hover {
    background-color: #e6f7ff;
}

#categoryItem {
    border: none;
    border-radius: 4px;
    background-color: transparent;
}

#categoryItemSelected {
    border: 2px solid #1890FF;
    border-radius: 4px;
    background-color: #e6f7ff;
}

#categoryIcon {
    min-width: 40px;
    min-height: 40px;
}

#categoryName {
    font-size: 12px;
    color: #666666;
}

#subCategoryArea {
    background-color: #F5F5F5;
    border-radius: 4px;
    border: none;
}

#categoryScroll {
    background-color: #fafbfc;
    border: none;
    border-radius: 4px;
}

#categoryGridPanel {
    background-color: #ffffff;
    border: 1px solid #E8E8E8;
    border-radius: 4px;
}

#categoryToggleBtn {
    font-size: 14px;
    color: #555555;
    border: 1px solid #E8E8E8;
    background-color: #ffffff;
    border-radius: 4px;
    padding: 2px 12px;
}

#categoryToggleBtn:hover {
    border-color: #1890FF;
    color: #1890FF;
}

#selectedCategoryLabel {
    font-size: 14px;
    color: #999999;
    padding: 0 8px;
}

#iconPreviewLabel {
    border: 1px solid #E8E8E8;
    border-radius: 4px;
    background-color: #F5F5F5;
}

#iconSelectBtn {
    min-width: 80px;
    height: 30px;
    border-radius: 4px;
    background-color: #F5F5F5;
    color: #555555;
    border: 1px solid #E8E8E8;
}

#iconSelectBtn:hover {
    border-color: #1890FF;
    color: #1890FF;
}

#iconGridItem {
    border: 1px solid #E8E8E8;
    border-radius: 4px;
    background-color: #ffffff;
    padding: 4px;
}

#iconGridItem:hover {
    border-color: #1890FF;
    background-color: #e6f7ff;
}

#iconGridItemSelected {
    border: 2px solid #1890FF;
    border-radius: 4px;
    background-color: #e6f7ff;
    padding: 4px;
}
